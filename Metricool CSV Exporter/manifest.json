{
  "manifest_version": 3,
  "name": "Metricool Shorts CSV Exporter",
  "version": "1.1.0",
"permissions": ["identity","scripting","activeTab","storage","tabs"],
"host_permissions": ["https://www.googleapis.com/*","https://drive.google.com/*"],
"action": { 
        "default_title": "Show/Hide Metricool Panel",
        "default_icon": {
            "16": "icons/uploader_16.png",
            "32": "icons/uploader_32.png",
            "48": "icons/uploader_48.png",
            "128": "icons/uploader_128.png"
        }
      },
  "icons": {
            "16": "icons/uploader_16.png",
            "32": "icons/uploader_32.png",
            "48": "icons/uploader_48.png",
            "128": "icons/uploader_128.png"
  },
  "oauth2": {
    "client_id": "122388271123-6u0flh5kqjulcudhipsjqd4lrro77d9p.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": [
      "https://drive.google.com/drive/folders/*",
      "https://drive.google.com/drive/u*/folders/*",
      "https://drive.google.com/drive/*/folders/*"
    ],
    "js": ["content.js"],
    "css": ["ui.css"],
    "run_at": "document_idle"
  }]
}
