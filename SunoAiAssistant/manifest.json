{
  "manifest_version": 3,
  "name": "Suno Playlist Downloader",
  "version": "1.1",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://suno.com/*",
    "https://studio-api.prod.suno.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/playlist/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["jszip.min.js", "page-downloader.js"],
      "matches": ["https://suno.com/*"]
    }
  ]
}
